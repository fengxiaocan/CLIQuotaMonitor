<Window x:Class="CLIQuotaMonitor.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CLIQuotaMonitor.App"
        mc:Ignorable="d"
        Title="CLI Quota Monitor"
        Width="390"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        Loaded="Window_Loaded"
        Closing="Window_Closing">
    <!-- Outer Card with Multi-Layer Drop Shadow -->
    <Border x:Name="MainBorder"
            Margin="12"
            Padding="14,12"
            Background="{DynamicResource ThemeWindowBackgroundBrush}"
            BorderBrush="{DynamicResource ThemeWindowBorderBrush}"
            BorderThickness="1"
            CornerRadius="14">
        <Border.Effect>
            <DropShadowEffect BlurRadius="22"
                              ShadowDepth="5"
                              Color="#000000"
                              Opacity="0.55"
                              Direction="270" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Provider Cards List (Detailed & Compact) -->
            <ItemsControl Grid.Row="0"
                          ItemsSource="{Binding ProviderCards}"
                          Visibility="{Binding DataContext.DisplayMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource DisplayModeVisibilityConverter}, ConverterParameter=!Minimal}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,8"
                                Padding="11,9"
                                Background="{DynamicResource ThemeCardBackgroundBrush}"
                                BorderBrush="{DynamicResource ThemeCardBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Visibility="{Binding IsVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Card Header: Badge, Name, Account, Status -->
                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <!-- Provider Brand Tag -->
                                        <Border CornerRadius="4"
                                                Background="{Binding BrandColor}"
                                                Padding="5,1"
                                                Margin="0,0,6,0"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding BrandBadgeText}"
                                                       FontSize="9"
                                                       FontWeight="Bold"
                                                       Foreground="#FFFFFF" />
                                        </Border>

                                        <TextBlock Text="{Binding DisplayName}"
                                                   FontSize="12.5"
                                                   FontWeight="SemiBold"
                                                   Foreground="#F8FAFC"
                                                   VerticalAlignment="Center" />

                                        <!-- Account Chip -->
                                        <Border CornerRadius="4"
                                                Background="#243044"
                                                Padding="5,1"
                                                Margin="6,0,0,0"
                                                VerticalAlignment="Center"
                                                Visibility="{Binding HasAccount, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <TextBlock Text="{Binding Account}"
                                                       FontSize="9.5"
                                                       Foreground="#94A3B8" />
                                        </Border>
                                    </StackPanel>

                                    <!-- Status Badge -->
                                    <Border Grid.Column="1"
                                            CornerRadius="9"
                                            Background="{Binding StatusBgColor}"
                                            Padding="7,2"
                                            VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse Width="5" Height="5"
                                                     Fill="{Binding StatusColor}"
                                                     Margin="0,0,5,0"
                                                     VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding StatusText}"
                                                       FontSize="10"
                                                       FontWeight="Medium"
                                                       Foreground="{Binding StatusColor}"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- Detailed Mode: Quota Items with Full-Width Progress Bars -->
                                <ItemsControl Grid.Row="1"
                                              Margin="0,7,0,0"
                                              ItemsSource="{Binding Quotas}"
                                              Visibility="{Binding DataContext.DisplayMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource DisplayModeVisibilityConverter}, ConverterParameter=Detailed}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,3">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <!-- Top: Name (Left) and Value + Reset (Right) -->
                                                <Grid Grid.Row="0" Margin="0,0,0,3">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Text="{Binding Name}"
                                                               FontSize="11.5"
                                                               Foreground="#E2E8F0"
                                                               FontWeight="Medium"
                                                               TextTrimming="CharacterEllipsis"
                                                               VerticalAlignment="Center" />

                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding RemainingText}"
                                                                   FontSize="11.5"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{Binding AccentColor}"
                                                                   VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding ResetText}"
                                                                   FontSize="10"
                                                                   Foreground="#94A3B8"
                                                                   Margin="6,0,0,0"
                                                                   VerticalAlignment="Center"
                                                                   Visibility="{Binding HasResetText, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                    </StackPanel>
                                                </Grid>

                                                <!-- Bottom: Custom Rounded Pill ProgressBar -->
                                                <ProgressBar Grid.Row="1"
                                                             Style="{StaticResource ModernProgressBarStyle}"
                                                             Minimum="0"
                                                             Maximum="100"
                                                             Value="{Binding RemainingPercent, Mode=OneWay}"
                                                             Foreground="{Binding AccentColor}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Compact Mode: Clean Inline Summary -->
                                <Border Grid.Row="1"
                                        Margin="0,6,0,0"
                                        Padding="8,5"
                                        Background="#16202E"
                                        CornerRadius="6"
                                        Visibility="{Binding DataContext.DisplayMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource DisplayModeVisibilityConverter}, ConverterParameter=Compact}">
                                    <TextBlock Text="{Binding CompactText}"
                                               FontSize="11"
                                               Foreground="#CBD5E1"
                                               TextTrimming="CharacterEllipsis" />
                                </Border>

                                <!-- Warning / Stale Banner -->
                                <Border Grid.Row="2"
                                        Margin="0,6,0,0"
                                        Padding="8,5"
                                        Background="#2D1B22"
                                        BorderBrush="#4C1D24"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Text="{Binding ErrorMessage}"
                                               TextWrapping="Wrap"
                                               FontSize="10"
                                               Foreground="#FCA5A5" />
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Provider Cards List (Minimal) -->
            <ItemsControl Grid.Row="0"
                          ItemsSource="{Binding ProviderCards}"
                          Visibility="{Binding DataContext.DisplayMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource DisplayModeVisibilityConverter}, ConverterParameter=Minimal}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,2" Visibility="{Binding IsVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" ToolTip="{Binding DisplayName}">
                                <TextBlock Text="{Binding MinimalPrefix}"
                                           FontFamily="Consolas, Cascadia Code, Segoe UI, monospace"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           Foreground="{Binding BrandColor}"
                                           Margin="0,0,7,0" />
                                <TextBlock Text="{Binding MinimalQuotasText}"
                                           FontFamily="Consolas, Cascadia Code, Segoe UI, monospace"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="#F1F5F9" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </Grid>
    </Border>
</Window>
